diff --git a/src/createAnimatedComponent/settledProps.ts b/src/createAnimatedComponent/settledProps.ts
new file mode 100644
--- /dev/null
+++ b/src/createAnimatedComponent/settledProps.ts
@@ -0,0 +1,44 @@
+'use strict';
+
+import type { StyleProps } from '../commonTypes';
+import { deepEqual } from '../css/utils/equality';
+
+// Settled props are decoded from native folly.dynamic: primitives, arrays and
+// plain data records. Do not infer equality for opaque HostObjects, accessors,
+// custom prototypes or cyclic values that happen to expose the same keys.
+function isNativeStyleValue(value: unknown, visiting?: WeakSet<object>): boolean {
+  if (value === null || value === undefined) return true;
+  if (typeof value !== 'object') {
+    return typeof value === 'string' || typeof value === 'number' || typeof value === 'boolean';
+  }
+  const ancestors = visiting ?? new WeakSet<object>();
+  try {
+    const array = Array.isArray(value);
+    const prototype = Object.getPrototypeOf(value);
+    if (array ? prototype !== Array.prototype : prototype !== Object.prototype && prototype !== null) return false;
+    if (ancestors.has(value)) return false;
+    const keys = Reflect.ownKeys(value);
+    // Empty opaque objects may report Object.prototype. Treat them conservatively.
+    if (!array && keys.length === 0) return false;
+    ancestors.add(value);
+    const descriptors = Object.getOwnPropertyDescriptors(value);
+    for (const key of keys) {
+      if (array && key === 'length') continue;
+      if (typeof key !== 'string') return false;
+      const descriptor = descriptors[key];
+      if (!descriptor?.enumerable || !('value' in descriptor) || !isNativeStyleValue(descriptor.value, ancestors)) return false;
+    }
+    ancestors.delete(value);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+export function haveSameSettledProps(previous: StyleProps, incoming: StyleProps): boolean {
+  return Object.keys(incoming).every((key) =>
+    Object.prototype.hasOwnProperty.call(previous, key) &&
+    isNativeStyleValue(previous[key]) && isNativeStyleValue(incoming[key]) &&
+    deepEqual(previous[key], incoming[key])
+  );
+}
