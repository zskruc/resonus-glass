index 0000000000000000000000000000000000000000..435ae00c27c1639d4a3d39b21e672ea122face9f
--- /dev/null
+++ b/android/src/main/java/expo/modules/image/StaticImageDecoder.kt
@@ -0,0 +1,73 @@
+package expo.modules.image
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.drawable.BitmapDrawable
+import android.os.Build
+import com.bumptech.glide.Glide
+import com.bumptech.glide.Registry
+import com.bumptech.glide.load.ImageHeaderParser.ImageType
+import com.bumptech.glide.load.ImageHeaderParserUtils
+import com.bumptech.glide.load.Options
+import com.bumptech.glide.load.ResourceDecoder
+import com.bumptech.glide.load.engine.Resource
+import com.bumptech.glide.load.resource.bitmap.BitmapDrawableDecoder
+import com.bumptech.glide.load.resource.bitmap.ByteBufferBitmapDecoder
+import com.bumptech.glide.load.resource.bitmap.ByteBufferBitmapImageDecoderResourceDecoder
+import com.bumptech.glide.load.resource.bitmap.Downsampler
+import com.bumptech.glide.load.resource.bitmap.InputStreamBitmapImageDecoderResourceDecoder
+import com.bumptech.glide.load.resource.bitmap.StreamBitmapDecoder
+import java.io.InputStream
+import java.nio.ByteBuffer
+
+/** Reuse Glide's sized bitmap decode and pool ownership for opt-in first frames. */
+internal fun registerStaticImageDecoders(context: Context, glide: Glide, registry: Registry) {
+  val parsers = registry.imageHeaderParsers
+  val downsampler = Downsampler(parsers, context.resources.displayMetrics, glide.bitmapPool, glide.arrayPool)
+  val buffers: ResourceDecoder<ByteBuffer, Bitmap>
+  val streams: ResourceDecoder<InputStream, Bitmap>
+  if (Build.VERSION.SDK_INT >= 28) {
+    // decodeBitmap returns one frame for GIF/WebP/APNG, unlike decodeDrawable.
+    buffers = ByteBufferBitmapImageDecoderResourceDecoder()
+    streams = InputStreamBitmapImageDecoderResourceDecoder()
+  } else {
+    buffers = ByteBufferBitmapDecoder(downsampler)
+    streams = StreamBitmapDecoder(downsampler, glide.arrayPool)
+  }
+  registry.prepend(
+    ByteBuffer::class.java,
+    BitmapDrawable::class.java,
+    StaticImageDecoder(BitmapDrawableDecoder(context.resources, buffers)) {
+      ImageHeaderParserUtils.getType(parsers, it.duplicate())
+    }
+  )
+  registry.prepend(
+    InputStream::class.java,
+    BitmapDrawable::class.java,
+    StaticImageDecoder(BitmapDrawableDecoder(context.resources, streams)) {
+      ImageHeaderParserUtils.getType(parsers, it, glide.arrayPool)
+    }
+  )
+}
+
+private class StaticImageDecoder<T : Any>(
+  private val decoder: ResourceDecoder<T, BitmapDrawable>,
+  private val imageType: (T) -> ImageType
+) : ResourceDecoder<T, BitmapDrawable> {
+  override fun handles(source: T, options: Options): Boolean {
+    if (options.get(CustomOptions.preferStatic) != true) return false
+    return when (imageType(source)) {
+      ImageType.GIF, ImageType.ANIMATED_WEBP,
+      // The ordinary PNG header includes APNG. Its default frame is sufficient
+      // for a list cover, with no frame sequence/decoder retained in memory.
+      ImageType.PNG, ImageType.PNG_A -> true
+      ImageType.ANIMATED_AVIF -> Build.VERSION.SDK_INT >= 31
+      // Leave JPEG/AVIF and unknown/vector formats to their existing loaders.
+      // In particular, old Android uses Glide's static libavif integration.
+      else -> false
+    }
+  }
+
+  override fun decode(source: T, width: Int, height: Int, options: Options): Resource<BitmapDrawable>? =
+    decoder.decode(source, width, height, options)
+}
