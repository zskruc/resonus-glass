+package expo.modules.image
+
+import android.content.Context
+import com.bumptech.glide.Glide
+import com.bumptech.glide.RequestManager
+import com.bumptech.glide.request.FutureTarget
+import com.bumptech.glide.load.model.GlideUrl
+import com.bumptech.glide.load.model.Headers
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.runInterruptible
+import kotlinx.coroutines.withContext
+import java.io.File
+
+/** Download encoded bytes into Glide's existing DATA cache without decoding. */
+internal suspend fun prefetchDiskImages(context: Context, urls: List<String>, headers: Headers): Boolean =
+  coroutineScope {
+    urls.map { url ->
+      async {
+        // Request creation/clearing stays on main; the blocking Future.get is
+        // interruptible on IO so module destruction cancels in-flight downloads.
+        var manager: RequestManager? = null
+        var target: FutureTarget<File>? = null
+        try {
+          withContext(Dispatchers.Main.immediate) {
+            val currentManager = Glide.with(context)
+            manager = currentManager
+            // Retain ownership before crossing a cancellable dispatcher boundary.
+            target = currentManager.downloadOnly().load(GlideUrl(url, headers)).submit()
+          }
+          val currentTarget = target ?: return@async false
+          runInterruptible(Dispatchers.IO) { currentTarget.get() }
+          true
+        } catch (cancellation: CancellationException) {
+          throw cancellation
+        } catch (_: Exception) {
+          false
+        } finally {
+          withContext(NonCancellable + Dispatchers.Main.immediate) {
+            target?.let { manager?.clear(it) }
+          }
+        }
+      }
+    }.awaitAll().all { it }
+  }
