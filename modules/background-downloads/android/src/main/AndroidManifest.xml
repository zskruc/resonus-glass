<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <application>
    <service android:name=".BackgroundDownloadService" android:exported="false"
      android:stopWithTask="false" android:foregroundServiceType="dataSync" />
    <service android:name=".BackgroundDownloadJobService" android:exported="false"
      android:permission="android.permission.BIND_JOB_SERVICE" />
    <receiver android:name=".DownloadNotificationReceiver" android:exported="false" />
  </application>
</manifest>
