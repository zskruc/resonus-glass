<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/hw_extra_root"
  android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
  android:padding="16dp" android:gravity="center_vertical" android:background="@drawable/hw_widget_background">
  <TextView android:id="@+id/hw_extra_title" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:maxLines="1" android:ellipsize="end" android:textSize="13sp" android:textColor="@color/hw_widget_secondary" android:layout_marginBottom="8dp" />
  <TextView android:id="@+id/hw_extra_one" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="32dp" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:textSize="16sp" android:textColor="@color/hw_widget_text" />
  <TextView android:id="@+id/hw_extra_two" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="32dp" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:textSize="16sp" android:textColor="@color/hw_widget_text" />
  <TextView android:id="@+id/hw_extra_three" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="32dp" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:textSize="16sp" android:textColor="@color/hw_widget_text" />
</LinearLayout>
